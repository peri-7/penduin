; program to save steps and dir and send back to main

.pio_version 1
.program read
.fifo txput

	mov isr, x          ; send 0 to fifo 
	mov rxfifo[0], isr

.wrap_target

	wait 1 pin 0  		; a step was made
	jmp pin dir_1 	 	; check direction

	; if dir=0 -> decreament counter
	dir_0:
		jmp x-- done
		jmp done

	; else -> increment counter with compliment trick
	dir_1:
		mov x, ~x
		jmp x-- compl

	compl:
		mov x, ~x

	done:
		wait 0 pin 0
		mov isr, x
		mov rxfifo[0], isr		
.wrap


% c-sdk {

static inline void read_program_init(PIO pio, uint sm, uint offset, uint jmp_pin, uint in_pin, float clkdiv) {
   
    pio_sm_config c = read_program_get_default_config(offset);

    pio_gpio_init(pio, jmp_pin);
    pio_gpio_init(pio, in_pin);

    sm_config_set_in_pins(&c, in_pin);
    sm_config_set_jmp_pin(&c, jmp_pin);

    sm_config_set_clkdiv(&c, clkdiv);

    pio_sm_init(pio, sm, offset, &c);
	pio_sm_exec(pio, sm, pio_encode_set(pio_x, 0));
    pio_sm_set_enabled(pio, sm, true);
}
%}
